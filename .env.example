# ============================================================
# ElevateBox Voice Agent — Environment Variables
# Copy this file to .env and fill in your real credentials.
# NEVER commit the real .env file.
# ============================================================

# ---- LiveKit ----
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Twilio (SIP trunk / outbound calling number) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
# Twilio WhatsApp sender number or sandbox number; example: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
# Printed by scripts/setup_twilio_trunk.py — paste it here before running
# scripts/setup_sip_trunk.py
TWILIO_TERMINATION_URI=
# Created by scripts/setup_sip_trunk.py — paste the printed trunk ID here
LIVEKIT_SIP_TRUNK_ID=

# SIP auth credentials you invent yourself, used for the Twilio<->LiveKit
# trunk handshake. Put the same values in Twilio's Elastic SIP Trunking
# "Credential List" for your trunk.
SIP_TRUNK_USERNAME=elevatebox-agent
SIP_TRUNK_PASSWORD=change_this_to_a_strong_password

# ---- Sarvam AI (STT + TTS) ----
SARVAM_API_KEY=
SARVAM_STT_LANGUAGE=unknown
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=transcribe
SARVAM_TTS_LANGUAGE=en-IN
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
# The agent switches TTS language per turn based on the caller's detected
# language/script (see agent/main.py: resolve_tts_language).

# ---- LLM (the decision engine) — Sarvam ----
SARVAM_LLM_BASE_URL=https://api.sarvam.ai/v1
SARVAM_LLM_MODEL=sarvam-105b-conversations

# ---- WhatsApp (sent via Twilio's WhatsApp API — see TWILIO_WHATSAPP_FROM above) ----
# The number that RECEIVES the summary/context message after every call —
# this should be the assignment's evaluator number.
WHATSAPP_RECIPIENT_NUMBER=917658975169

# ---- Your details (used inside the WhatsApp message + call persona) ----
YOUR_NAME=Vara Prasad
YOUR_PHONE_NUMBER=
# Public URL to your resume PDF (must be a direct, public link — WhatsApp
# needs to fetch it, and a normal Google Drive "view" link serves an HTML
# viewer page instead of the file, which breaks this). If using Drive: set
# sharing to "anyone with the link", grab the file ID from the share URL,
# and use https://drive.google.com/uc?export=download&id=FILE_ID instead of
# the /view link. Hosting it anywhere else public (Cloudinary, GitHub raw,
# S3, etc.) also works and is more reliable for larger files.
RESUME_PUBLIC_URL=
# Public URL to your architecture diagram image (png/jpg). Same rule as above.
ARCHITECTURE_DIAGRAM_URL=

# ---- The number this agent calls (from the assignment) ----
TARGET_PHONE_NUMBER=+917658975169

# ---- Web trigger (server/app.py) — "call this number now" page ----
# Shared password the trigger form checks before dispatching a call. Pick a
# real value — there is no default, and the endpoint refuses every request
# until this is set.
CALL_TRIGGER_PASSWORD=
# Minimum seconds between two triggered calls, to stop the password (once
# known) from being used to spam calls.
MIN_SECONDS_BETWEEN_CALLS=30

# ---- Storage (call state, transcripts, scheduled callbacks) ----
# SQLite file path — no external DB needed for this assignment
DATABASE_PATH=./call_data.db
